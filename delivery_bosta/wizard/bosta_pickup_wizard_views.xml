<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bosta_pickup_wizard_form" model="ir.ui.view">
        <field name="name">bosta.pickup.wizard.form</field>
        <field name="model">bosta.pickup.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Bosta Pickup">
                <sheet>
                    <div class="oe_title">
                        <h2>📅 Schedule Bosta Pickup</h2>
                    </div>

                    <group string="Delivery Orders">
                        <field name="picking_ids"
                               widget="many2many_tags"
                               placeholder="Select delivery orders to pick up…"/>
                    </group>

                    <group string="Pickup Details" col="2">
                        <group>
                            <field name="pickup_date"/>
                            <field name="pickup_from_time" placeholder="09:00"/>
                            <field name="pickup_to_time"   placeholder="18:00"/>
                        </group>
                        <group>
                            <field name="contact_person"/>
                            <field name="contact_phone"/>
                        </group>
                        <group col="2">
                            <field name="pickup_address" colspan="2"/>
                        </group>
                        <group col="2">
                            <field name="notes" placeholder="Any special instructions for the courier…"
                                   colspan="2"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_schedule_pickup"
                            type="object"
                            string="📅 Schedule Pickup"
                            class="btn btn-primary"
                            data-hotkey="s"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bosta_pickup_wizard" model="ir.actions.act_window">
        <field name="name">Schedule Bosta Pickup</field>
        <field name="res_model">bosta.pickup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
