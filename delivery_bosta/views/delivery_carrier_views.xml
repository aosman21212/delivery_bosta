<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the delivery carrier form with Bosta credentials and defaults -->
    <record id="view_delivery_carrier_form_bosta" model="ir.ui.view">
        <field name="name">delivery.carrier.form.bosta</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">

            <!-- Bosta credentials section — shown only when Bosta is selected -->
            <field name="integration_level" position="after">
                <group string="🔑 Bosta API Credentials"
                       invisible="delivery_type != 'bosta'"
                       col="2">
                    <group>
                        <field name="bosta_api_key"
                               password="True"
                               placeholder="e.g. eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9…"/>
                        <field name="bosta_environment"/>
                    </group>
                    <group>
                        <div class="o_row">
                            <button name="action_bosta_test_connection"
                                    type="object"
                                    string="✅ Test Connection"
                                    class="btn btn-outline-primary btn-sm"/>
                        </div>
                    </group>
                </group>

                <group string="📦 Shipment Defaults"
                       invisible="delivery_type != 'bosta'"
                       col="2">
                    <group>
                        <field name="bosta_default_shipment_type"/>
                        <field name="bosta_default_package_size"/>
                    </group>
                    <group>
                        <field name="bosta_default_open_package"/>
                    </group>
                </group>
            </field>

        </field>
    </record>

</odoo>
