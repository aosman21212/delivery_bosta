<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show Bosta tracking info on the sale order -->
    <record id="view_sale_order_form_bosta" model="ir.ui.view">
        <field name="name">sale.order.form.bosta</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart button: Bosta tracking summary -->
            <div name="button_box" position="inside">
                <button type="object"
                        name="action_view_delivery"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="not is_bosta_order or delivery_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Bosta</span>
                        <span class="o_stat_value">
                            <field name="bosta_tracking_info" readonly="1"/>
                        </span>
                    </div>
                </button>
            </div>

            <!-- Hidden fields -->
            <field name="client_order_ref" position="after">
                <field name="is_bosta_order" invisible="1"/>
                <field name="bosta_tracking_info" invisible="1"/>
            </field>

        </field>
    </record>

</odoo>
